OFFICE_LLM_DECISION_TEMPERATURE=0.72
OFFICE_LLM_DECISION_MAX_TOKENS=600
DIALOGUE_INFLUENCE_TTL_TICKS=8
DIALOGUE_INTERRUPT_CURRENT_EPISODE=true
MEMORY_COMPACT_THRESHOLD=72
MEMORY_COMPACT_KEEP_RECENT=24
MEMORY_COMPACT_BATCH_SIZE=36
MEMORY_SUMMARY_USE_LLM=true
MEMORY_SUMMARY_MAX_TOKENS=420
LANGCHAIN_ENABLED=true
LANGGRAPH_ENABLED=true
RAG_ENABLED=true
KNOWLEDGE_DIR=./knowledge_base
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
BOSS_TASK_MODE_ENABLED=true
AGENT_TOOL_LOOP_MAX_STEPS=12
AGENT_AUTONOMOUS_RESOURCE_ENABLED=false
AGENT_AUTONOMOUS_DOC_INTERVAL_TICKS=12
AGENT_AUTONOMOUS_CODE_INTERVAL_TICKS=18
AGENT_AUTONOMOUS_DYNAMIC_TOOL_INTERVAL_TICKS=24
AGENT_AUTONOMOUS_BROWSER_INTERVAL_TICKS=21
AGENT_DIFFICULTY_AUTO_BROWSE=false
BROWSER_SEARCH_ENABLED=true
BROWSER_SEARCH_PROVIDER=duckduckgo_html
BROWSER_SEARCH_MAX_RESULTS=4
BROWSER_FETCH_TIMEOUT_SECONDS=8
