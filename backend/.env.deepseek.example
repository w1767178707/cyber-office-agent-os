OFFICE_DECISION_MODE=llm_parallel
OFFICE_LLM_DECISION_ENABLED=true
OFFICE_LLM_DECISION_COOLDOWN_TICKS=0
OFFICE_LLM_DECISION_BUDGET_PER_TICK=0
OFFICE_LLM_FORCE_BUDGET_PER_TICK=0
